PPE_DOMAIN=ppe.example.com
PPE_USERNAME=admin
PPE_PASSWORD=replace-with-a-long-random-password
PPE_DEVICE=cpu
PPE_IMGSZ=512
PPE_MAX_DATASET_UPLOAD_MB=2048

